# Copy to .env (git-ignored): cp .env.example .env. These are EXAMPLE values; every secret must be replaced.

# Repository the runner serves.
REPO_URL=https://github.com/OWNER/REPO

# Registration, option A: a fine-grained personal access token (or GitHub App token) limited to this one repository
# with the permission "Administration: read and write", from which the image obtains a registration token at every
# start. Option B (recommended, keeps the token out of the container): leave ACCESS_TOKEN empty and start the runner
# with scripts/run-ephemeral.sh, which fetches a one-hour registration token on the host and passes it as RUNNER_TOKEN.
ACCESS_TOKEN=
RUNNER_TOKEN=
RUNNER_NAME_PREFIX=ecommerce
# scripts/run-ephemeral.sh only: seconds a runner may stay idle (not busy, nothing queued) before its container is
# stopped, and how often the GitHub API is polled for queued runs and the runners' state.
RUNNER_IDLE_TIMEOUT=900
RUNNER_POLL_INTERVAL=30
# false: no light runner (runner-light, label ecommerce-light, for image, publish and aggregate jobs); `runner` then
# serves every job alone.
#RUNNER_LIGHT=true
# Resources of the runner containers. scripts/run-ephemeral.sh derives the defaults from the ENGINE (`docker info`, i.e.
# the Linux VM on macOS): `runner` gets all CPUs but one and the memory less 4 GiB (9 CPUs and 10g on a 10-CPU,
# 14 GiB VM), because the containers that jobs start through the Docker socket run outside the cap and need the rest;
# runner-light gets 2 CPUs and 1536m. `scripts/run-ephemeral.sh --print-config` shows the values in effect.
#RUNNER_CPUS=9
#RUNNER_MEM_LIMIT=10g
#RUNNER_LIGHT_CPUS=2
#RUNNER_LIGHT_MEM_LIMIT=1536m
# Gradle inside CI jobs (default: one worker per CPU left after the daemons, at most 6, and a 4 GB daemon heap from a
# 10g cap on, 3 GB from 7g, 2 GB below; gradle.properties has 4 workers and 3 GB).
#RUNNER_GRADLE_OPTS=-Dorg.gradle.workers.max=6 "-Dorg.gradle.jvmargs=-Xmx4g -XX:+UseParallelGC -Dfile.encoding=UTF-8 --sun-misc-unsafe-memory-access=allow"
# false: keep dangling images and build cache older than 72 h (default: scripts/run-ephemeral.sh prunes them when a
# session ends; tagged images and volumes are never touched).
#RUNNER_PRUNE=true

# Work directories of the runners: absolute directories of the ENGINE host, mounted at the same path in the runner
# containers (jobs pass paths to sibling containers). Empty (recommended): scripts/run-ephemeral.sh creates the engine
# volumes ci-runner-work and ci-runner-work-light and uses their mount points, which sit on the engine's native disk on
# Linux and on macOS alike. Never point them at a macOS folder shared into the engine VM (/Users/...): every checkout,
# Gradle build and npm install then goes through the VM's file share, 30 to 50 times slower for small files. A path
# set here must exist on the engine host (sudo mkdir -p /srv/ci-runner/work); a plain `docker compose up -d runner`
# without the script uses /srv/ci-runner/work.
RUNNER_WORKDIR=
#RUNNER_LIGHT_WORKDIR=
# Engine socket on the engine host, mounted into the runners as /var/run/docker.sock (rootless Podman:
# /run/user/<uid>/podman/podman.sock).
#DOCKER_SOCKET=/var/run/docker.sock

# Private registry (research.md section 5): host name and port that jobs and Docker use, i.e. the GitHub repository
# variable REGISTRY_HOST. A name other than localhost needs the certificate to carry it (scripts/init-registry.sh).
REGISTRY_HOST=localhost:5443
REGISTRY_PORT=5443
REGISTRY_BIND_ADDRESS=127.0.0.1
# User of the registry (repository secret REGISTRY_USERNAME); its password is chosen by scripts/init-registry.sh.
REGISTRY_USERNAME=ci

# Pact Broker: URL for jobs on this host is http://localhost:<port> (repository secret PACT_BROKER_URL).
PACT_BROKER_PORT=9292
PACT_BROKER_BIND_ADDRESS=127.0.0.1
PACT_BROKER_BASIC_AUTH_USERNAME=pact
PACT_BROKER_BASIC_AUTH_PASSWORD=change-me-pact-broker
PACT_BROKER_DB_PASSWORD=change-me-pact-db
