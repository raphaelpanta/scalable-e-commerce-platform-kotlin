# syntax=docker/dockerfile:1
# Storefront image (feature 005, research section 7): the Vite bundle of frontend/ served by a rootless nginx.
# Built by Docker Compose (platform/compose/docker-compose.yml, service `storefront`) and by hand from the repository
# root: docker build -f platform/docker/Dockerfile.storefront -t storefront:dev .
# Base images are pinned by digest (resolved 2026-10-06); refresh them deliberately (platform/docker/README.md,
# "Storefront image").
#
# Stage 1 installs the dependencies from the lock file before the sources are copied, so a source change reuses the
# `npm ci` layer. `npm run build` first regenerates src/api/generated from the OpenAPI contracts (scripts/generate-api.mjs
# reads them relative to the repository root), so the two contract directories are part of the context (.dockerignore
# re-includes them) and the host's generated copy is excluded.

FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS build
ENV CI=true
WORKDIR /workspace/frontend
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --ignore-scripts --silent --no-audit --no-fund
COPY specs/004-ecommerce-platform-mvp/contracts/openapi /workspace/specs/004-ecommerce-platform-mvp/contracts/openapi
COPY specs/005-storefront-dev-bootstrap/contracts/openapi /workspace/specs/005-storefront-dev-bootstrap/contracts/openapi
COPY frontend/ ./
# The Vite manifest only feeds the bundle-budget check; it is not served.
RUN npm run build --silent && rm -rf dist/.vite

# Runtime: nginx as the image's unprivileged user (uid 101, `USER 101` in the base image), listening on 8080.
# The copy replaces the image's default server block; the main nginx.conf (pid and temp paths under /tmp) is kept.
FROM nginxinc/nginx-unprivileged:stable-alpine@sha256:15c994d10d6d78658721c3bcafff14cb281fba2a4bdf9d5ba92c416a472516e3
COPY --from=build /workspace/frontend/dist /usr/share/nginx/html
COPY platform/docker/storefront/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
# Same probe as the Compose health check and .github/scripts/image-health.sh (busybox wget; the image has no curl or bash).
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
