{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Real user monitoring of the storefront from its browser telemetry (spec 005, FR-031, FR-032): page-load and action p95 by route template with the SC-004 thresholds (2 s and 1 s), client error rate, throttled or dropped telemetry exports, recent browser spans joined to the services by correlation id (SC-011).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Requests by correlation id",
      "type": "link",
      "url": "/d/requests-by-correlation/requests-by-correlation?${__url_time_range}",
      "icon": "external link",
      "tooltip": "Log lines of every service for one X-Correlation-Id",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": []
    },
    {
      "title": "Service RED",
      "type": "link",
      "url": "/d/service-red/service-red?${__url_time_range}",
      "icon": "external link",
      "tooltip": "Request rate, error rate and p95 latency per service",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Page-load p95 by route template (SC-004: 2 s)",
      "description": "95th percentile of the document-load span (`documentLoad`, OpenTelemetry web document-load instrumentation) of spans with resource.service.name=\"storefront\", grouped by span.http.route; spans without http.route fall back to span.page.route (query B).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"storefront\" && name=\"documentLoad\" && span.http.route=~\"$route\"} | quantile_over_time(duration, .95) by (span.http.route)",
          "limit": 20,
          "tableType": "spans",
          "step": ""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"storefront\" && name=\"documentLoad\" && span.http.route = nil && span.page.route=~\"$route\"} | quantile_over_time(duration, .95) by (span.page.route)",
          "limit": 20,
          "tableType": "spans",
          "step": ""
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{.*?=\"([^\"]*)\"\\}$",
            "renamePattern": "$1"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Action p95 by route template (SC-004: 1 s)",
      "description": "95th percentile of the storefront's platform calls (fetch instrumentation: spans carrying span.http.request.method or the legacy span.http.method), grouped by span.http.route. Threshold: 1 second for an action to show its result.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"storefront\" && (span.http.request.method != nil || span.http.method != nil) && span.http.route=~\"$route\"} | quantile_over_time(duration, .95) by (span.http.route)",
          "limit": 20,
          "tableType": "spans",
          "step": ""
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^\\{.*?=\"([^\"]*)\"\\}$",
            "renamePattern": "$1"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Client error rate",
      "description": "Client-side error records exported by the storefront (window error, unhandled rejection, failed actions): OpenTelemetry log records with labels service=\"storefront\" and level=\"ERROR\"; the route template is structured metadata (http_route). Bodies are stable event names such as client.error, never messages.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 9,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (http_route) (rate({service=\"storefront\", level=\"ERROR\"} | http_route=~\"$route\" [$__auto]))",
          "legendFormat": "{{http_route}}",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Client errors, last hour",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"storefront\", level=\"ERROR\"} | http_route=~\"$route\" [1h]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Attributes redacted, last hour",
      "description": "Sum of redaction.redacted.count over the storefront's spans: attributes the collector's second privacy layer removed because the browser exported a key outside the allow-list (FR-032). Should stay 0; a value points at a defect of the storefront telemetry module.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 9,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"storefront\" && span.redaction.redacted.count > 0} | count_over_time()",
          "limit": 20,
          "tableType": "spans",
          "step": ""
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Telemetry exports throttled or dropped by the gateway",
      "description": "Gateway access lines (structured metadata method, path, status, durationMs) on /api/v1/telemetry/ answered 429 throttled (browse tier, per source address), 413 payload-too-large (256 KiB) or 503 unavailable (collector down). The storefront drops these batches silently (FR-032).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (count_over_time({service=\"gateway\"} | path=~\"/api/v1/telemetry/.*\" | status=~\"429|413|503\" [$__auto]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "429"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "413"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "503"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent storefront spans",
      "description": "Latest browser spans with their correlation id, route template and duration. The correlation id links to Requests by correlation id, which lists the gateway access line and every service line of the same page view or action (SC-011).",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"storefront\" && (span.http.route=~\"$route\" || span.page.route=~\"$route\")} | select(resource.correlation.id, resource.session.id, span.http.route, span.page.route, span.http.request.method, span.http.response.status_code, span.interaction.kind, span.error.type)",
          "limit": 100,
          "spss": 1,
          "tableType": "spans",
          "step": ""
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(resource|span)\\.(.*)$",
            "renamePattern": "$2"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "traceIdHidden": true
            },
            "indexByName": {
              "time": 0,
              "traceService": 1,
              "traceName": 2,
              "correlation.id": 3,
              "http.route": 4,
              "page.route": 5,
              "http.request.method": 6,
              "http.response.status_code": 7,
              "interaction.kind": 8,
              "error.type": 9,
              "duration": 10,
              "session.id": 11
            },
            "renameByName": {
              "traceService": "Service",
              "traceName": "Span",
              "correlation.id": "correlation.id",
              "duration": "Duration"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "correlation.id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Requests by correlation id",
                    "url": "/d/requests-by-correlation/requests-by-correlation?var-correlationId=${__data.fields[\"correlation.id\"]}&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "ecommerce",
    "storefront",
    "rum"
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "route",
        "label": "Route template",
        "description": "Route template of the page or platform call (`/products/:id`), as exported by the storefront in span.http.route",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "definition": "span.http.route",
        "query": {
          "type": 1,
          "label": "span.http.route",
          "refId": "TempoVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Storefront RUM",
  "uid": "storefront-rum",
  "version": 1
}
