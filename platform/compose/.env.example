# Copy to .env (git-ignored) before the first start: cp .env.example .env
# These are example values for LOCAL DEVELOPMENT ONLY. Change them if the stack is reachable by others.

# Shared secret sent as X-Internal-Token on service-to-service /internal/** calls.
INTERNAL_API_TOKEN=local-internal-token-change-me

# Ed25519 private key (PKCS#8 DER, Base64) that signs every access token; all identity replicas share it (FR-024).
# Required: identity does not start without it. Generate one (the scripts do it when they create .env):
#   openssl genpkey -algorithm ed25519 -outform DER | base64
IDENTITY_SIGNING_KEY=

# true: identity and catalog run their Flyway seed scripts (profile `seed`) at start-up.
SEED=true

# Grafana login: user `admin`.
GRAFANA_ADMIN_PASSWORD=admin-local-only

# Pact Broker (profile `ci`).
PACT_BROKER_BASIC_AUTH_USERNAME=pact
PACT_BROKER_BASIC_AUTH_PASSWORD=pact-local-only
PACT_BROKER_DB_PASSWORD=pact-db-local-only

# Host interface for the published ports (gateway 8080, Grafana 3000, Mailpit 8025, Pact Broker 9292).
# 0.0.0.0 exposes them to the network.
BIND_ADDRESS=127.0.0.1

# JWT_ISSUER=https://identity.ecommerce.local
# JWT_AUDIENCE=ecommerce-api

# Serialises image builds that share the Gradle cache mount; the cold-start measurement of 3 min 58 s assumes it.
COMPOSE_PARALLEL_LIMIT=1

# Host port of the public gateway (change when another local service already listens on 8080)
GATEWAY_PORT=8080
