# LOCAL DEVELOPMENT DEFAULTS ONLY. This file is committed on purpose: the credentials below protect a throw-away
# PostgreSQL that is reachable only on the Compose internal network (no host port is published). Never reuse them
# anywhere else. Shared values (Kafka, JWT, OTLP, internal API token) live in docker-compose.yml and .env.
# Read by the payment service and, for the POSTGRES_* keys, by the payment-db container.
PAYMENT_DB_HOST=payment-db
PAYMENT_DB_USER=payment
PAYMENT_DB_PASSWORD=payment-local-only
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment-local-only
POSTGRES_DB=payment
