# LOCAL DEVELOPMENT DEFAULTS ONLY. This file is committed on purpose: the credentials below protect a throw-away
# PostgreSQL that is reachable only on the Compose internal network (no host port is published). Never reuse them
# anywhere else. Shared values (Kafka, JWT, OTLP, internal API token) live in docker-compose.yml and .env.
# Read by the identity service and, for the POSTGRES_* keys, by the identity-db container.
IDENTITY_DB_HOST=identity-db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=identity-local-only
POSTGRES_USER=identity
POSTGRES_PASSWORD=identity-local-only
POSTGRES_DB=identity
# The Ed25519 key that signs access tokens, shared by every identity replica (FR-024); not committed: it comes from
# .env (IDENTITY_SIGNING_KEY, see README.md "Configuration"). Identity refuses to start without it.
IDENTITY_SIGNING_KEY=${IDENTITY_SIGNING_KEY}
# Everything the acceptance runner sends reaches identity from one address, so the per-source sign-in limit is
# raised here; the per-account (and per unknown email) limit stays at 5 (FR-006).
IDENTITY_SOURCE_MAX_FAILURES=20
