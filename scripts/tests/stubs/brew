#!/usr/bin/env bash
# Fake Homebrew: `brew install <formula>...` marks the tools installed; `--cask` fails, as the scripts never use it.
set -euo pipefail
source "$(dirname "$0")/_stub_lib.sh"
stub_log "$@"
case "${1:-}" in
  install)
    shift
    for f in "$@"; do
      case "$f" in
        --cask) echo "stub brew: casks are never installed by the scripts" >&2; exit 1 ;;
        -*) continue ;;
      esac
      # shellcheck disable=SC2046  # word splitting of the tool list is intended
      stub_mark_installed $(stub_package_tools "$f")
    done ;;
esac
