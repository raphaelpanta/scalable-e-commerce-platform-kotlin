#!/usr/bin/env bash
# Fake jq: logs, answers `--version`, passes the rest to the real jq (STUB_REAL_JQ).
set -euo pipefail
source "$(dirname "$0")/_stub_lib.sh"
stub_log "$@"
stub_is_absent jq && stub_not_found jq
case "${1:-}" in
  --version) printf 'jq-%s\n' "${STUB_JQ_VERSION:-1.7.1}"; exit 0 ;;
esac
exec "${STUB_REAL_JQ:?STUB_REAL_JQ must point to the real jq}" "$@"
