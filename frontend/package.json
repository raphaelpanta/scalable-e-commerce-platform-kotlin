{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "description": "Web storefront of the e-commerce platform (TypeScript + React, constitution Principle VII).",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs",
    "ensure-generated": "node scripts/generate-api.mjs --ensure",
    "lint": "npm run --silent generate && prettier --log-level warn --check . && eslint --max-warnings 0 . && tsc --noEmit",
    "test": "npm run --silent ensure-generated && node scripts/quiet.mjs vitest run --reporter=dot --silent=passed-only",
    "build": "npm run --silent ensure-generated && node scripts/quiet.mjs vite build --logLevel warn",
    "dev": "npm run --silent ensure-generated && vite",
    "acceptance": "node acceptance/run.mjs",
    "mutate": "npm run --silent ensure-generated && node scripts/quiet.mjs stryker run",
    "pact": "npm run --silent ensure-generated && node scripts/quiet.mjs vitest run --reporter=dot --silent=passed-only --config pact/vitest.pact.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cucumber/cucumber": "13.2.1",
    "@pact-foundation/pact": "17.1.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "jsdom": "30.1.1",
    "msw": "3.0.2",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
