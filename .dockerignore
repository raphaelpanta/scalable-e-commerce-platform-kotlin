**/build
# ...but not the Kotlin package com.ecommerce.build of the convention plugins
!build-logic/src/*/kotlin/com/ecommerce/build
.gradle
**/.gradle
.git
.kotlin
.idea

# Storefront (platform/docker/Dockerfile.storefront): dependencies, bundles and the generated API types are produced
# inside the image, never taken from the host
frontend/node_modules
frontend/dist
frontend/build
frontend/src/api/generated
# Run output of the frontend's visual suite (rewritten by every verify), and Finder metadata: in the context they would
# change the `COPY . .` layer of the JVM and native images and force a full Gradle (and native-image) rebuild
frontend/visual/.dist
frontend/visual/test-results
frontend/visual/playwright-report
**/.DS_Store

# Agent worktrees are nested checkouts, never part of the build context or the repository
.claude/worktrees/

# Not needed to build a service jar; keeping them out of the context keeps image layers cacheable
platform/
docs/
specs/
.github/
.specify/
scripts/
.claude/
.tokensave/
.rtk/
# ...except what the storefront image copies: its nginx server block and the OpenAPI contracts that
# frontend/scripts/generate-api.mjs turns into src/api/generated (a few small files; they also enter the
# context of the JVM images, where `COPY . .` ignores nothing)
!platform/docker/storefront
# ...and the Gradle init script that only platform/docker/Dockerfile.native passes to the build
!platform/docker/native
!specs/004-ecommerce-platform-mvp/contracts/openapi
!specs/005-storefront-dev-bootstrap/contracts/openapi
