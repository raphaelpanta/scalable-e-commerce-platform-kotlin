**/build
# ...but not the Kotlin package com.ecommerce.build of the convention plugins
!build-logic/src/*/kotlin/com/ecommerce/build
.gradle
**/.gradle
.git
.kotlin
.idea
frontend/node_modules

# Agent worktrees are nested checkouts, never part of the build context or the repository
.claude/worktrees/

# Not needed to build a service jar; keeping them out of the context keeps image layers cacheable
platform/
docs/
specs/
.github/
.specify/
scripts/
.claude/
